<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="AppTheme.Day" />
    <style name="AppTheme.Day" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">#f3f0e8</item>
        <item name="android:colorBackground">#f3f0e8</item>
        <item name="android:statusBarColor">#f3f0e8</item>
        <item name="android:navigationBarColor">#f3f0e8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">#282922</item>
        <item name="android:textColorSecondary">#606156</item>
        <item name="android:colorAccent">#3d5942</item>
        <item name="android:colorControlActivated">#3d5942</item>
        <item name="android:colorControlNormal">#737b6c</item>
        <item name="android:textColorHighlight">#663d5942</item>
        <item name="android:colorEdgeEffect">#3d5942</item>
        <item name="android:alertDialogTheme">@style/Md3DialogTheme.Day</item>
        <item name="android:datePickerDialogTheme">@style/Md3DialogTheme.Day</item>
        <item name="android:timePickerDialogTheme">@style/Md3DialogTheme.Day</item>
    </style>
    <style name="AppTheme.Night" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#101113</item>
        <item name="android:colorBackground">#101113</item>
        <item name="android:statusBarColor">#101113</item>
        <item name="android:navigationBarColor">#101113</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">#e4e5df</item>
        <item name="android:textColorSecondary">#b2b7b0</item>
        <item name="android:colorAccent">#b6cfad</item>
        <item name="android:colorControlActivated">#b6cfad</item>
        <item name="android:colorControlNormal">#90988c</item>
        <item name="android:textColorHighlight">#66b6cfad</item>
        <item name="android:colorEdgeEffect">#b6cfad</item>
        <item name="android:alertDialogTheme">@style/Md3DialogTheme.Night</item>
        <item name="android:datePickerDialogTheme">@style/Md3DialogTheme.Night</item>
        <item name="android:timePickerDialogTheme">@style/Md3DialogTheme.Night</item>
    </style>
    <style name="Md3DialogTheme" parent="Md3DialogTheme.Day" />
    <style name="Md3DialogTheme.Day" parent="@android:style/Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:windowBackground">#ded8ca</item>
        <item name="android:colorBackground">#ded8ca</item>
        <item name="android:colorAccent">#3d5942</item>
        <item name="android:colorControlActivated">#3d5942</item>
        <item name="android:colorControlNormal">#737b6c</item>
        <item name="android:textColorPrimary">#282922</item>
        <item name="android:textColorSecondary">#606156</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>
    <style name="Md3DialogTheme.Night" parent="@android:style/Theme.DeviceDefault.Dialog.Alert">
        <item name="android:windowBackground">#292c30</item>
        <item name="android:colorBackground">#292c30</item>
        <item name="android:colorAccent">#b6cfad</item>
        <item name="android:colorControlActivated">#b6cfad</item>
        <item name="android:colorControlNormal">#90988c</item>
        <item name="android:textColorPrimary">#e4e5df</item>
        <item name="android:textColorSecondary">#b2b7b0</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>
</resources>
